# Copy to .env; fill a local database password. Never commit .env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=5173
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=auditlens
# Development migration administrator only, never a future runtime identity.
DATABASE_USER=auditlens_dev
DATABASE_PASSWORD=
# Reserved for Phase 2; currently unused. Supply independent secrets then.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=


# Deterministic synthetic fixture (unsigned 32-bit integer).
AUDITLENS_DATA_SEED=20260914
# Reset is opt-in for each local reset invocation; leave unset normally.
# AUDITLENS_ALLOW_LOCAL_RESET=YES
