# Copy to .env; replace placeholders locally. Never commit .env.
NODE_ENV=development
API_HOST=127.0.0.1
PORT=3001
WEB_PORT=5173
# Optional custom hostname for local Vite preview only (not production).
# WEB_ALLOWED_HOST=preview.example.test

# Single PostgreSQL connection string used by AuditLens.
DATABASE_URL=postgresql://auditlens_dev:CHANGE_ME@127.0.0.1:5432/auditlens

# Docker PostgreSQL initialization only; match the password in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME

# Reserved for Phase 2.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Deterministic synthetic fixture.
AUDITLENS_DATA_SEED=20260914
# Local destructive reset protection.
# AUDITLENS_ALLOW_LOCAL_RESET=YES
# Explicit local database privilege administration (changes PUBLIC grants).
# AUDITLENS_ALLOW_READER_PROVISION=YES

# Public web configuration.
API_URL=http://localhost:3001
